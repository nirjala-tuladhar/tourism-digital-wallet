PORT=
NODE_ENV=
MONGODB_URI=
MONGODB_DNS_SERVERS=
JWT_SECRET=
JWT_EXPIRES_IN=7d
FRONTEND_URL=
# Comma-separated extra origins, for example a staging URL.
FRONTEND_URLS=
# true allows https://*.vercel.app (preview deploys). Production should set false
# and list the real site in FRONTEND_URL.
CORS_ALLOW_VERCEL=true

# Backblaze B2 (S3-compatible)
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_REGION=
B2_ENDPOINT=
MAX_FILE_SIZE_MB=10
B2_UPLOAD_URL_EXPIRES_IN=300
B2_DOWNLOAD_URL_EXPIRES_IN=300
